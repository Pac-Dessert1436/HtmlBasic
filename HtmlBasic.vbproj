<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- NOTE: Change output type to Library when this should be used as a library -->
    <RootNamespace>HtmlBasic</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Irony.dll">
      <HintPath>Irony.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>